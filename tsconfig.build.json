{
  // Build config for TypeScript 7 (`tsc` from the @typescript/native package).
  // TypeScript 7 removed `moduleResolution: node10`, which tsconfig.json still
  // sets for the tools that run on the TypeScript 6 API (ts-jest, ts-node,
  // typescript-eslint). node16 resolution is the TypeScript 7 equivalent, and
  // because package.json declares no "type" the emit stays CommonJS.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "node16",
    "moduleResolution": "node16"
  }
}
